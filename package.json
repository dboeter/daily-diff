{
  "name": "daily-diff",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "manifest": "tsx src/cli/manifest.ts",
    "readme": "tsx src/cli/readme.ts",
    "notify": "tsx src/cli/notify.ts",
    "close-stale": "tsx src/cli/close-stale.ts",
    "feeds:check": "tsx scripts/check-feeds.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "js-yaml": "^4.3.2",
    "marked": "^17.0.6",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
